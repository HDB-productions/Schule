{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "klausurbewertung-sync",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "ARCHIVE", "class_name": "ArchiveStore" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ArchiveStore"] }
  ]
}
