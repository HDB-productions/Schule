      "start": 151.21,
      "title": "Wieder messbereit"
    }
  ],
  "beats": [
    {
      "start": 0,
      "title": "Strahlung wird zählbar",
      "text": "Wie wird aus einer unsichtbaren Wechselwirkung ein messbarer Impuls? Ein Blick in unseren Geiger-Müller-Zähler.",
      "tag": "Geiger-Müller-Zähler",
      "mode": "exterior",
      "part": null,
      "phase": "off",
      "points": [
        "Handmessgerät mit flachem Pancake-Sensor",
        "Anzeige und Klickton machen Zählereignisse sichtbar und hörbar."
      ]
    },
    {
      "start": 13.72,
      "title": "Vom Gerät zum Sensor",
      "text": "Das Gehäuse öffnet sich. Im Inneren wird die Funktion der Bauteile sichtbar.",
      "tag": "Explosionsansicht",
      "mode": "open",
      "part": null,
      "phase": "off",
      "points": [
        "Außenform nach Herstellerreferenz",
        "Innenaufbau als Unterrichtsmodell"
      ]
    },
    {
      "start": 17.54,
      "title": "Ein flaches, rundes Zählrohr",
      "text": "Wir betrachten die Bauform eines tragbaren Strahlungsmessgerätes. Im runden Sensor befindet sich der gasgefüllte Raum.",
      "tag": "",
      "mode": "part",
      "part": null,
      "phase": "off",
      "points": [
        "Wiedererkennbare Bauform unseres Messgerätes",
        "Innenaufbau als vereinfachtes Unterrichtsmodell"
      ],
      "showLabel": false
    },
    {
      "start": 21.7,
      "title": "Die Gasfüllung",
      "text": "Das Gasgemisch besteht hauptsächlich aus Edelgas. In diesem Gas kann Strahlung Ladungsträger erzeugen.",
      "tag": "Gasgemisch · hauptsächlich Edelgas",
      "mode": "part",
      "part": "gas",
      "phase": "off",
      "points": [
        "Gasfüllung im geschlossenen Sensor",
        "Das Gas wird später stark vergrößert gezeigt."
      ]
    },
    {
      "start": 22,
      "title": "Die äußere Elektrode",
      "text": "Das leitfähige Metallgehäuse des Zählrohrs bildet die Kathode.",
      "tag": "Kathode · Metallgehäuse",
      "mode": "part",
      "part": "cathode",
      "phase": "off",
      "points": [
        "Die Kathode begrenzt den Gasraum.",
        "Sie liegt gegenüber der Anode am negativen Pol."
      ]
    },
    {
      "start": 23.2,
      "title": "Das dünne Eintrittsfenster",
      "text": "Das Glimmerfenster schließt den Gasraum ab. Strahlung kann durch das empfindliche Fenster eindringen.",
      "tag": "Glimmerfenster",
      "mode": "part",
      "part": "window",
      "phase": "off",
      "points": [
        "Sehr dünne, gasdichte Fensterebene",
        "Das äußere Gitter schützt das Fenster."
      ]
    },
    {
      "start": 34.06,
      "title": "Der positive Leiter",
      "text": "Im Gasraum liegt der dünne Anodenleiter. Er zieht freie Elektronen an.",
      "tag": "Anode · positiver Leiter",
      "mode": "part",
      "part": "anode",
      "phase": "off",
      "points": [
        "Das Feld ist nahe dem dünnen Leiter besonders stark.",
        "Die gezeigte Drahtform ist schematisch."
      ]
    },
    {
      "start": 39.38,
      "title": "Spannung erzeugt ein Feld",
      "text": "Die Hochspannungsversorgung hält eine Spannung zwischen Anode und Kathode aufrecht.",
      "tag": "Hochspannungsversorgung",
      "mode": "part",
      "part": "voltage",
      "phase": "off",
      "points": [
        "Anode: positives Potential",
        "Kathode: negatives Potential gegenüber der Anode"
      ]
    },
    {
      "start": 49.48,
      "title": "Die Zählelektronik",
      "text": "Die Zählelektronik verarbeitet die elektrischen Impulse des Sensors.",
      "tag": "Zählelektronik",
      "mode": "part",
      "part": "counter",
      "phase": "off",
      "points": [
        "Ein Impuls wird als ein Ereignis gezählt.",
        "Die Elektronik steuert Anzeige und Klickton."
      ]
    },
    {
      "start": 57.72,
      "title": "Wir schauen in das Gas",
      "text": "Die Bauteile rücken wieder zusammen. Die Lupe richtet sich auf den gasgefüllten Raum des Sensors.",
      "tag": "Gasraum · Vergrößerung",
      "mode": "gas",
      "part": "gas",
      "phase": "off",
      "points": [
        "Gas und Teilchen stark vergrößert",
        "Arbeitsposition des zusammengebauten Sensors"
      ]
    },
    {
      "start": 63.24,
      "title": "Zunächst elektrisch neutral",
      "text": "Gasatome besitzen positive Kerne und negative Elektronen. Insgesamt ist ein Atom zunächst neutral.",
      "tag": "Neutrale Gasatome",
      "mode": "gas",
      "part": "gas",
      "phase": "off",
      "points": [
        "Protonen (+) und Neutronen (0) im Kern",
        "Elektronen (−) in der Atomhülle"
      ]
    },
    {
      "start": 73.04,
      "title": "Strahlung trifft auf das Gas",
      "text": "Eine Wechselwirkung kann ein Elektron aus einem Atom lösen. Das Atom wird ionisiert.",
      "tag": "Eintritt und Ionisation",
      "mode": "gas",
      "part": "gas",
      "phase": "entryIon",
      "points": [
        "Ein freies Elektron entsteht.",
        "Ein positiv geladenes Ion bleibt zurück."
      ]
    },
    {
      "start": 84.06,
      "title": "Aus einem Atom werden Ladungsträger",
      "text": "Ionisation erzeugt ein Paar aus negativem Elektron und positivem Ion.",
      "tag": "Ionisation",
      "mode": "gas",
      "part": "gas",
      "phase": "ionization",
      "points": [
        "Elektron: negativ",
        "Ion: positiv"
      ]
    },
    {
      "start": 87.34,
      "title": "Das Feld trennt die Ladungen",
      "text": "Elektronen bewegen sich zur Anode. Positive Ionen wandern zur Kathode.",
      "tag": "Bewegung im elektrischen Feld",
      "mode": "gas",
      "part": "gas",
      "phase": "drift",
      "points": [
        "Elektronen → Anode (+)",
        "Positive Ionen → Kathode (−)"
      ]
    },
    {
      "start": 96.9,
      "title": "Elektronen sind viel schneller",
      "text": "Die leichten Elektronen erreichen den Anodenbereich wesentlich schneller als die schweren positiven Ionen.",
      "tag": "Unterschiedliche Beweglichkeit",
      "mode": "gas",
      "part": "gas",
      "phase": "driftEnd",
      "points": [
        "Die Ionen bewegen sich ebenfalls.",
        "Alle Vorgänge sind stark verlangsamt dargestellt."
      ]
    },
    {
      "start": 102.24,
      "title": "Weitere Ionisationen",
      "text": "Im starken Feld nahe der Anode werden Elektronen beschleunigt. Sie können weitere Elektronen freisetzen.",
      "tag": "Sekundärionisation",
      "mode": "gas",
      "part": "gas",
      "phase": "avalanche",
      "points": [
        "Aus wenigen Elektronen werden viele.",
        "Die Vermehrung findet nahe der Anode statt."
      ]
    },
    {
      "start": 113.08,
      "title": "Eine Elektronenlawine",
      "text": "Die kurze Entladung erzeugt ein elektrisches Signal. Die vielen Elektronen gehören zu demselben Nachweisereignis.",
      "tag": "Elektronenlawine → Impuls",
      "mode": "gas",
      "part": "gas",
      "phase": "avalancheEnd",
      "points": [
        "Verstärkung im Gas",
        "Ein äußeres Signal für die Elektronik"
      ]
    },
    {
      "start": 118.49,
      "title": "Ein Impuls wird gezählt",
      "text": "Die Elektronik registriert den Impuls. Ein weiteres Zählereignis erscheint in der Anzeige.",
      "tag": "Ein Impuls · ein Ereignis",
      "mode": "pulse",
      "part": "gas",
      "phase": "pulse",
      "points": [
        "Nicht jedes Elektron wird einzeln gezählt.",
        "Der Impuls steht für eine registrierte Wechselwirkung."
      ]
    },
    {
      "start": 131.57,
      "title": "Was wurde nachgewiesen?",
      "text": "Registriert wurde eine Wechselwirkung im Detektor. Ein einzelner Impuls verrät nicht die Strahlungsart oder ihre Energie.",
      "tag": "Grenzen eines Zählimpulses",
      "mode": "gas",
      "part": "gas",
      "phase": "off",
      "points": [
        "Nachweis durch Ionisation",
        "Keine Energie- oder Teilchenbestimmung aus einem Einzelimpuls"
      ]
    },
    {
      "start": 136.05,
      "title": "Strahlung kann unbemerkt passieren",
      "text": "Ohne geeignete Wechselwirkung entsteht kein registrierbarer Impuls.",
      "tag": "Kein Impuls ohne Wechselwirkung",
      "mode": "gas",
      "part": "gas",
      "phase": "miss",
      "points": [
        "Nicht jedes einfallende Teilchen wird erfasst.",
        "Ein Durchgang kann ungezählt bleiben."
      ]
    },
    {
      "start": 151.21,
      "title": "Positive Ionen bleiben zurück",
      "text": "Nach der schnellen Elektronenbewegung sind noch langsame positive Ionen im Gas vorhanden.",
      "tag": "Ionenwolke",
      "mode": "gas",
      "part": "gas",
      "phase": "quenchStart",
      "points": [
        "Positive Ionen wandern zur Kathode.",
        "Ihre Ladung verändert das elektrische Feld."
      ]
    },
    {
      "start": 169.99,
      "title": "Eine kurze Totzeit",
      "text": "Positive Ionen schwächen das Feld nahe der Anode. Kurzzeitig entsteht keine neue Elektronenlawine und damit kein weiterer Zählimpuls.",
      "tag": "Totzeit",
      "mode": "gas",
      "part": "gas",
      "phase": "deadtime",
      "points": [
        "Diese kurze Zeit heißt Totzeit.",
        "Während die Ionen zur Kathode wandern, wird das Feld wieder stärker."
      ]
    },
    {
      "start": 188.72,
      "title": "Schneller als man denkt",
      "text": "Die Ionen bewegen sich langsamer als die Elektronen. Trotzdem laufen die Vorgänge im Zählrohr sehr schnell ab.",
      "tag": "Eine sehr kurze Zeit",
      "mode": "gas",
      "part": "gas",
      "phase": "deadtimeRecovery",
      "points": [
        "Langsamer heißt: im Vergleich zu den Elektronen.",
        "Unsere Animation zeigt die Vorgänge stark verlangsamt."
      ]
    },
    {
      "start": 198.36,
      "title": "Schnell wieder messbereit",
      "text": "Im Gerät laufen diese Vorgänge sehr schnell ab. Unsere Darstellung dehnt die Zeit, damit wir sie verfolgen können.",
      "tag": "Stark verlangsamt dargestellt",
      "mode": "ending",
      "part": null,
      "phase": "off",
      "points": [
        "Ionisation → Verstärkung → Impuls",
        "Kurze Totzeit → nächster Nachweis"
      ]
    }
  ],
